# Backend
APP_ENV=development
SERVER_PORT=8080
JWT_ISSUER=momento
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_me_with_a_long_random_string
ARGON2_PARALLELISM=1
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=momento
POSTGRES_USER=momento
POSTGRES_PASSWORD=momento_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage (MinIO in dev, S3-compatible in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=momento
S3_SECRET_KEY=momento_dev_password
S3_BUCKET=momento-media
S3_REGION=us-east-1

# Nexconn (Chat + Call SDK backend integration) — from https://dashboard.nexconn.ai
# The App Secret must ONLY be set as an environment variable, never in source.
NEXCONN_APP_ID=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE_URL=https://api-<region>.nexconn.ai
NEXCONN_WS_BASE_URL=wss://ws-<region>.nexconn.ai
# Data center the Android SDK connects to: BJ, SG, NA, SA or OM (must match the app key).
NEXCONN_AREA_CODE=SG

# Firebase Cloud Messaging
FCM_SERVICE_ACCOUNT_JSON=/run/secrets/fcm-service-account.json

# Android
ANDROID_API_BASE_URL=http://10.0.2.2:8080/
